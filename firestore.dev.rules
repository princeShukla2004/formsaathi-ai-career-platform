// DEVELOPMENT / EMULATOR RULES ONLY — DO NOT DEPLOY TO PRODUCTION
// Documented test rules for local Firebase Emulator experimentation.
// Production deployments must always use /firestore.rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
