# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYMENT_GATEWAY_WEBHOOK_SECRET: Optional webhook secret for verifying live subscription payments.
# Leave unset to keep subscription upgrades in transparent test mode.
PAYMENT_GATEWAY_WEBHOOK_SECRET=
